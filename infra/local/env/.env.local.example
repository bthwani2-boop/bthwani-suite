# Copy this file to C:\bthwani-suite\.env.local
# Do not commit C:\bthwani-suite\.env.local

BTHWANI_ENV=local
BTHWANI_LOCAL_LIVE_TEST=1

# Stack/addon defaults
BTHWANI_STACK=all
BTHWANI_ADDONS=none

# DSH Go API — host port 8080 (reserved for DSH only, not Expo)
DSH_API_PORT=8080
DSH_API_BASE_URL=http://localhost:8080
# DATABASE_URL used by DSH API when running from host (not Docker):
DATABASE_URL=postgres://dsh_local:dsh_local_password@localhost:15432/dsh_local?sslmode=disable

# DSH Postgres — host port 15432 -> container 5432
POSTGRES_DB=dsh_local
POSTGRES_USER=dsh_local
POSTGRES_PASSWORD=dsh_local_password
POSTGRES_PORT=15432

# Auth service — host port 18082 -> container 18082 (avoids Expo app-partner port 8082)
DSH_AUTH_SERVICE_HOST_PORT=18082

# WLT Postgres — host port 15433 -> container 5432
WLT_POSTGRES_DB=wlt_local
WLT_POSTGRES_USER=wlt_local
WLT_POSTGRES_PASSWORD=wlt_local_password
WLT_POSTGRES_PORT=15433

# WLT API — host port 18083 -> container 8083 (avoids Expo app-captain port 8083)
WLT_HOST_PORT=18083

# WLT calls DSH API via service name inside Docker (default).
# Change to http://host.docker.internal:8080 only if DSH runs from host outside Docker.
WLT_DSH_BASE_URL=http://dsh-api:8080

# Optional MongoDB addon (profile: mongo)
MONGO_PORT=27017
MONGO_ROOT_USERNAME=bthwani_local
MONGO_ROOT_PASSWORD=bthwani_mongo_local_password

# Optional Redis addon (profile: redis)
REDIS_PORT=6379

# Expo / mobile apps — ports reserved exclusively for Expo/Metro
EXPO_PUBLIC_DSH_API_BASE_URL=http://localhost:8080
EXPO_HOST=localhost
EXPO_CLEAR=0

# Control Panel
NEXT_PUBLIC_DSH_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WLT_API_BASE_URL=http://localhost:18083

# Dev ports (Metro/Expo — do NOT assign backend services to these)
APP_CLIENT_PORT=8081
APP_PARTNER_PORT=8082
APP_CAPTAIN_PORT=8083
APP_FIELD_PORT=8084
CONTROL_PANEL_PORT=3000

# ADB mode: usb or wifi
ADB_MODE=wifi
ADB_SERIAL=R58NC2AFCVF
ADB_WIFI_PORT=5555

# Scrcpy
SCRCPY_ENABLED=1
SCRCPY_PATH=C:\Android\scrcpy\scrcpy-win64-v2.4\scrcpy.exe
SCRCPY_BIT_RATE=8M
SCRCPY_MAX_FPS=30
SCRCPY_MAX_SIZE=1280
