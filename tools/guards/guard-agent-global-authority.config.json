{
  "version": "2.0.0",
  "requiredPaths": [
    ".agents/INDEX.md",
    ".agents/AUTHORITY_BOUNDARY.md",
    ".agents/UPDATE_POLICY.md",
    "AGENTS.md"
  ],
  "forbiddenRoots": [
    ".github/skills",
    ".github/agents",
    ".opencode/skills"
  ],
  "forbiddenBridgeNamePatterns": [
    "bridge-only"
  ],
  "adapterRoots": [
    ".agents/adapters"
  ],
  "maxAdapterLines": 160,
  "maxGovernanceMentionsPerAdapter": 6,
  "allowContextPatterns": [
    "legacy",
    "Legacy",
    "retired",
    "Retired",
    "historical",
    "Historical",
    "forbidden",
    "Forbidden",
    "do not",
    "Do not",
    "deleted",
    "Deleted",
    "remove",
    "Remove",
    "not active",
    "inactive"
  ],
  "allowSectionPatterns": [
    "Forbidden actions",
    "What not to create",
    "What was rejected",
    "Why there was no direct restore"
  ]
}
