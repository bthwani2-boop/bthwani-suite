{
  "version": "2.0.0",
  "requiredGuardFiles": [
    "tools/guards/README.md",
    "tools/guards/GUARDS_CATALOG.md",
    "tools/guards/RUN_GOVERNANCE_GUARDS.ps1",
    "tools/guards/RUN_AGENT_GUARDS.ps1",
    "tools/guards/guard-manifest.json",
    "tools/guards/_guard-common.mjs",
    "tools/guards/lib/guard-utils.mjs"
  ],
  "allowedDirectories": [
    "lib"
  ],
  "allowContextPatterns": [
    "legacy",
    "Legacy",
    "retired",
    "Retired",
    "historical",
    "Historical",
    "forbidden",
    "Forbidden",
    "deleted",
    "Deleted",
    "do not",
    "Do not",
    "remove",
    "Remove",
    "not active",
    "inactive"
  ],
  "forbiddenLineRules": [
    {
      "code": "RETIRED_GITHUB_SKILLS_REF",
      "pattern": "\\.github/skills",
      "severity": "error",
      "detail": "Retired .github/skills reference detected in active guard source."
    },
    {
      "code": "RETIRED_GITHUB_AGENTS_REF",
      "pattern": "\\.github/agents",
      "severity": "error",
      "detail": "Retired .github/agents reference detected in active guard source."
    },
    {
      "code": "RETIRED_OPENCODE_SKILLS_REF",
      "pattern": "\\.opencode/skills",
      "severity": "error",
      "detail": "Retired .opencode/skills reference detected in active guard source."
    },
    {
      "code": "LEGACY_HANDOFF_ZIP",
      "pattern": "_HANDOFF\\.zip",
      "severity": "error",
      "detail": "Legacy _HANDOFF.zip rule detected in active guard source."
    },
    {
      "code": "NPMX_USAGE",
      "pattern": "\\bnpx\\b",
      "severity": "error",
      "detail": "npx reference detected in active guard source."
    },
    {
      "code": "LEGACY_ACTIVE_PATH",
      "pattern": "(^|[^A-Za-z0-9_])(apps/|packages/)",
      "severity": "error",
      "detail": "Legacy active path detected in active guard source."
    }
  ]
}
