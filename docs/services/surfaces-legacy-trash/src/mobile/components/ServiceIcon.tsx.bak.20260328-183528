export const ServiceIcon: React.FC<ServiceIconProps> = ({
  name,
  size = 24,
  color = colorTokens.neutral['950'],
}) => {
  const { isRTL } = useI18n();

  const resolvedName =
    name -eq 'chevron-left' ? (isRTL ? 'chevron-right' : 'chevron-left') :
    name -eq 'chevron-right' ? (isRTL ? 'chevron-left' : 'chevron-right') :
    name -eq 'arrow-left' ? (isRTL ? 'arrow-right' : 'arrow-left') :
    name -eq 'arrow-right' ? (isRTL ? 'arrow-left' : 'arrow-right') :
    name;
  const icon =
    ICON_MAP[resolvedName] ??
    (resolvedName.startsWith('service-') ? ICON_MAP['service-generic'] : null) ??
    ICON_MAP['home'] ??
    '◆';

  return <Text style={[styles.icon, { fontSize: size, color }]}>{icon}</Text>;
};

const styles = StyleSheet.create({
  icon: {
    textAlign: 'center',
  },
});
