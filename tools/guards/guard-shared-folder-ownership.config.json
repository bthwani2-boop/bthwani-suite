{
  "$schema": "https://bthwani.local/schemas/shared-folder-ownership-guard.schema.json",
  "version": "1.0.0",
  "evidenceRoot": "tools/registry/runs",
  "failOnError": false,
  "extensions": [
    ".ts",
    ".tsx",
    ".js",
    ".jsx",
    ".mjs",
    ".cjs",
    ".json",
    ".md",
    ".yml",
    ".yaml"
  ],
  "scanRoots": [
    "app-client",
    "app-partner",
    "app-captain",
    "app-field",
    "webapp",
    "website",
    "control-panel",
    "ui-kit",
    "dsh",
    "wlt",
    "knz",
    "arb",
    "amn",
    "esf",
    "mrf",
    "snd",
    "kwd"
  ],
  "ignore": [
    "(^|/)node_modules(/|$)",
    "(^|/)dist(/|$)",
    "(^|/)build(/|$)",
    "(^|/)coverage(/|$)",
    "(^|/)\\.next(/|$)",
    "(^|/)\\.expo(/|$)",
    "^tools/registry/runs/",
    "\\.map$",
    "\\.lock$"
  ],
  "domainTerms": [
    "dsh",
    "wlt",
    "amn",
    "arb",
    "knz",
    "kwd",
    "mrf",
    "snd",
    "esf",
    "order",
    "orders",
    "store",
    "stores",
    "cart",
    "checkout",
    "captain",
    "merchant",
    "partner",
    "wallet",
    "delivery",
    "shopping"
  ],
  "productTerms": [
    "OrderCard",
    "StoreCard",
    "WalletSummary",
    "CaptainTask",
    "DshOrder",
    "ProductMedia",
    "MarketingGrowth",
    "Checkout",
    "Cart",
    "StoreAccount",
    "order",
    "store",
    "wallet",
    "captain",
    "checkout",
    "cart"
  ],
  "surfaceGlobalTerms": [
    "account",
    "search",
    "notification",
    "notifications",
    "support",
    "settings",
    "profile",
    "home"
  ],
  "localDesignPatterns": [
    "\\bcreateTamagui\\b",
    "\\bTamaguiProvider\\b",
    "\\btokens\\s*[:=]",
    "\\bthemes\\s*[:=]",
    "\\bcreateTokens\\b"
  ]
}
