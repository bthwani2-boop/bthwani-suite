# BTHWANI_WLT_API Dockerfile
# Multi-stage build: compiles Go binary then runs on alpine.
# Context: wlt/ (workspace root/wlt directory — contains domain/ and backend/).

FROM golang:1.24-alpine AS builder
WORKDIR /src
COPY domain/ ./domain/
COPY backend/go.mod backend/go.sum ./backend/
WORKDIR /src/backend
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/wlt-api ./cmd/wlt-api/

FROM alpine:3.20
LABEL org.opencontainers.image.title="bthwani-wlt-api" \
      org.opencontainers.image.description="BThwani WLT wallet/finance backend" \
      org.opencontainers.image.source="https://github.com/bthwani2-boop/bthwani-suite"
RUN apk add --no-cache wget ca-certificates \
 && addgroup -S appgroup && adduser -S appuser -G appgroup
WORKDIR /app
COPY --from=builder /out/wlt-api ./wlt-api
RUN chown appuser:appgroup ./wlt-api
USER appuser
EXPOSE 8083
ENTRYPOINT ["./wlt-api"]
