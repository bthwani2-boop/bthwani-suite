{
  "name": "app-partner",
  "root": "apps/mobile/app-partner",
  "sourceRoot": "apps/mobile/app-partner/src",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vite --config apps/mobile/app-partner/vite.config.ts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/apps/mobile/app-partner"
      ],
      "options": {
        "command": "pnpm exec vite build --config apps/mobile/app-partner/vite.config.ts"
      }
    },
    "expo": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pwsh -File tools/scripts/start-mobile-preview.ps1 -App app-partner -Mode lan -Clear"
      }
    },
    "expo-tunnel": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pwsh -File tools/scripts/start-mobile-preview.ps1 -App app-partner -Mode tunnel -Clear"
      }
    }
  }
}