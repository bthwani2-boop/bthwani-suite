{
  "$schema": "../../tools/schemas/tsconfig.schema.json",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": false,
    "baseUrl": "../..",
    "rootDir": "./src",
    "outDir": "./dist",
    "ignoreDeprecations": "5.0",
    "types": ["react", "react-native"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"]
}
