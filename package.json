{
  "name": "bthwani-suite",
  "version": "0.0.0",
  "private": true,
  "description": "Bootstrap workspace shell for the bthwani-suite clean build line",
  "scripts": {
    "phase:review": "echo Review phase evidence under tools/registry/runs",
    "serve:surfaces": "pnpm nx run-many --target=serve --projects=control-panel,webapp,website,app-client,app-partner,app-captain,app-field --parallel=7",
    "build:surfaces": "pnpm nx run-many --target=build --projects=control-panel,webapp,website,app-client,app-partner,app-captain,app-field --parallel=7",
    "build:mobile-control-panel": "pnpm nx run-many --target=build --projects=control-panel,app-client,app-partner,app-captain,app-field --parallel=5",
    "guard:agent-governance": "node tools/scripts/validate-agent-governance.mjs",
    "guard:i18n-direction": "node tools/scripts/guard-central-i18n-direction.mjs",
    "guard:i18n-direction:mobile-control-panel": "node tools/scripts/guard-central-i18n-direction.mjs apps/mobile apps/web/control-panel packages",
    "guard:service-blueprint": "node tools/guards/guard-service-blueprint-completeness.mjs",
    "guard:test-coverage": "node tools/guards/guard-test-coverage-threshold.mjs",
    "guard:binding-proof": "node tools/guards/guard-binding-proof.mjs",
    "guard:patch-review": "node tools/guards/guard-patch-review-sensitive-changes.mjs",
    "guard:visual": "node tools/guards/guard-visual-regression-evidence.mjs",
    "guard:rtl-visual": "node tools/guards/guard-rtl-visual-proof.mjs",
    "guard:secret-scan": "node tools/guards/guard-secret-scan.mjs",
    "guard:runtime-smoke": "node tools/guards/guard-runtime-smoke-test.mjs",
    "precommit:fast": "pnpm -w exec tsc --noEmit && node tools/guards/guard-empty-placeholder-zero-byte-files.mjs && node tools/guards/guard-typescript-strictness.mjs",
    "guard:protected-tokens": "node tools/guards/guard-bthwani-protected-tokens.mjs",
    "guard:tamagui-law": "node tools/guards/guard-tamagui-governance-law.mjs",
    "guard:tamagui-import-boundary": "node tools/guards/guard-tamagui-import-boundary.mjs",
    "tamagui:version": "tamagui --version",
    "tamagui:build": "tamagui build",
    "tamagui:check": "pnpm run tamagui:version && pnpm run tamagui:build"
  },
  "packageManager": "pnpm@8.15.0+sha512.ea45517d5285d123eac02c3793505fa1fd6da90a2fc60d1e8d9e0c1e9292886ecfaff513f062b9d1cc8021bb8615033b1ac5bea3b2ee3fc165a6d7034bbe6b03",
  "pnpm": {
    "overrides": {
      "expo": "~54.0.0",
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "react-native": "0.81.0"
    }
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@tamagui/cli": "2.0.0-rc.41",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "expo": "~54.0.0",
    "next": "16.2.2",
    "nx": "22.3.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@tamagui/config": "2.0.0-rc.41",
    "tamagui": "2.0.0-rc.41"
  }
}
