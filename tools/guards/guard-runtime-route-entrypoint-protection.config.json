{
  "guard": "GUARD-08_RUNTIME_ROUTE_ENTRYPOINT_PROTECTION",
  "version": "1.0.0",
  "mode": "CHECK_ONLY",
  "nextRoutePatterns": [
    "^apps/web/[^/]+/app/.*/(page|layout|route|loading|error|not-found|template)\\.(ts|tsx|js|jsx)$",
    "^apps/web/[^/]+/app/(page|layout|route|loading|error|not-found|template)\\.(ts|tsx|js|jsx)$"
  ],
  "runtimeNamePatterns": [
    "(SurfaceHost|AppShell|bootstrap|navigation|router|provider|providers|Root|Entry|Host)\\.(ts|tsx|js|jsx|mjs|cjs)$"
  ],
  "rootEntrypointPatterns": [
    "^apps/mobile/[^/]+/(App|index|main)\\.(ts|tsx|js|jsx)$",
    "^apps/web/[^/]+/(next\\.config|middleware)\\.(ts|js|mjs|cjs)$"
  ],
  "policy": {
    "guard03ProtectedEntrypointSeverity": "warning"
  }
}
