{
  "$schema": "./tools/schemas/tsconfig.schema.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@bthwani/ui-kit": [
        "./ui-kit/src/index.ts"
      ],
      "@bthwani/ui-kit/*": [
        "./ui-kit/src/*"
      ],
      "@bthwani/surface-mobile": [
        "./packages/surface-mobile/src/index.tsx"
      ],
      "@bthwani/surfaces": [
        "./packages/surfaces/src/index.ts"
      ],
      "@bthwani/surfaces/*": [
        "./packages/surfaces/src/service-owned/*"
      ],
      "@bthwani/surfaces/service-owned/*": [
        "./packages/surfaces/src/service-owned/*"
      ],
      "@bthwani/surfaces/surface-owned/*": [
        "./packages/surfaces/src/surface-owned/*"
      ],
      "@bthwani/surfaces/composition/*": [
        "./packages/surfaces/src/composition/*"
      ],
      "@bthwani/dsh/*": [
        "./dsh/frontend/*",
        "./packages/surfaces/src/service-owned/dsh/*"
      ],
      "@bthwani/wlt/*": [
        "./wlt/*",
        "./packages/surfaces/src/service-owned/wlt/*"
      ],
      "@bthwani/wlt": [
        "./wlt/index.ts"
      ],
      "@bthwani/knz/*": [
        "./knz/*",
        "./packages/surfaces/src/service-owned/knz/*"
      ],
      "@bthwani/knz": [
        "./knz/index.ts"
      ],
      "@bthwani/arb/*": [
        "./arb/*",
        "./packages/surfaces/src/service-owned/arb/*"
      ],
      "@bthwani/arb": [
        "./arb/index.ts"
      ],
      "@bthwani/amn/*": [
        "./amn/*",
        "./packages/surfaces/src/service-owned/amn/*"
      ],
      "@bthwani/amn": [
        "./amn/index.ts"
      ],
      "@bthwani/esf/*": [
        "./esf/*",
        "./packages/surfaces/src/service-owned/esf/*"
      ],
      "@bthwani/esf": [
        "./esf/index.ts"
      ],
      "@bthwani/mrf/*": [
        "./mrf/*",
        "./packages/surfaces/src/service-owned/mrf/*"
      ],
      "@bthwani/mrf": [
        "./mrf/index.ts"
      ],
      "@bthwani/snd/*": [
        "./snd/*",
        "./packages/surfaces/src/service-owned/snd/*"
      ],
      "@bthwani/snd": [
        "./snd/index.ts"
      ],
      "@bthwani/kwd/*": [
        "./kwd/*",
        "./packages/surfaces/src/service-owned/kwd/*"
      ],
      "@bthwani/kwd": [
        "./kwd/index.ts"
      ],
      "@bthwani/dsh": [
        "./dsh/index.ts"
      ],
      "@bthwani/dsh/backend": [
        "./dsh/backend/client.ts"
      ],
      "@bthwani/dsh/backend/*": [
        "./dsh/backend/*"
      ],
      "@bthwani/wlt/backend": [
        "./wlt/backend/client.ts"
      ],
      "@bthwani/wlt/backend/*": [
        "./wlt/backend/*"
      ],
      "@bthwani/knz/backend": [
        "./knz/backend/client.ts"
      ],
      "@bthwani/knz/backend/*": [
        "./knz/backend/*"
      ],
      "@bthwani/arb/backend": [
        "./arb/backend/client.ts"
      ],
      "@bthwani/arb/backend/*": [
        "./arb/backend/*"
      ],
      "@bthwani/amn/backend": [
        "./amn/backend/client.ts"
      ],
      "@bthwani/amn/backend/*": [
        "./amn/backend/*"
      ],
      "@bthwani/esf/backend": [
        "./esf/backend/client.ts"
      ],
      "@bthwani/esf/backend/*": [
        "./esf/backend/*"
      ],
      "@bthwani/mrf/backend": [
        "./mrf/backend/client.ts"
      ],
      "@bthwani/mrf/backend/*": [
        "./mrf/backend/*"
      ],
      "@bthwani/snd/backend": [
        "./snd/backend/client.ts"
      ],
      "@bthwani/snd/backend/*": [
        "./snd/backend/*"
      ],
      "@bthwani/kwd/backend": [
        "./kwd/backend/client.ts"
      ],
      "@bthwani/kwd/backend/*": [
        "./kwd/backend/*"
      ],
      "@bthwani/app-client/*": [
        "./app-client/*",
        "./app-client/runtime/*"
      ],
      "@bthwani/control-panel/*": [
        "./control-panel/*",
        "./control-panel/runtime/*"
      ],
      "@bthwani/webapp/*": [
        "./webapp/*"
      ],
      "@bthwani/website/*": [
        "./website/*"
      ],
      "@bthwani/media-fixtures": [
        "./packages/media-fixtures/src/index.ts"
      ],
      "@bthwani/media-fixtures/*": [
        "./packages/media-fixtures/src/*"
      ]
    },
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
