{
  "name": "bthwani-suite",
  "version": "0.0.0",
  "private": true,
  "description": "Bootstrap workspace shell for the bthwani-suite clean build line",
  "scripts": {
    "phase:review": "echo Review phase evidence under tools/registry/runs",
    "serve:surfaces": "pnpm nx run-many --target=serve --projects=control-panel,webapp,website,app-client,app-partner,app-captain,app-field --parallel=7",
    "build:surfaces": "pnpm nx run-many --target=build --projects=control-panel,webapp,website,app-client,app-partner,app-captain,app-field --parallel=7",
    "build:mobile-control-panel": "pnpm nx run-many --target=build --projects=control-panel,app-client,app-partner,app-captain,app-field --parallel=5",
    "guard:i18n-direction": "node tools/scripts/guard-central-i18n-direction.mjs",
    "guard:i18n-direction:mobile-control-panel": "node tools/scripts/guard-central-i18n-direction.mjs app-client app-partner app-captain app-field control-panel webapp website",
    "guard:service-blueprint": "pnpm run guard:governance",
    "guard:test-coverage": "pnpm run guard:governance",
    "guard:binding-proof": "pnpm run guard:governance",
    "guard:patch-review": "pnpm run guard:governance",
    "guard:visual": "pnpm run guard:governance",
    "guard:rtl-visual": "pnpm run guard:governance",
    "guard:secret-scan": "node tools/guards/guard-secret-scan.mjs",
    "guard:runtime-smoke": "pnpm run guard:governance",
    "precommit:fast": "pnpm -w exec tsc --noEmit",
    "guard:protected-tokens": "pnpm run guard:governance",
    "guard:tamagui-law": "pnpm run guard:governance",
    "guard:tamagui-import-boundary": "node tools/guards/guard-ui-architecture-boundary.mjs",
    "lint": "eslint . --max-warnings 0",
    "tamagui:version": "tamagui --version",
    "tamagui:build": "tamagui build",
    "tamagui:check": "pnpm run tamagui:version && pnpm run tamagui:build",
    "guard:governance": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/guards/RUN_GOVERNANCE_GUARDS.ps1 -Mode Local -Profile Governance",
    "guard:agent": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/guards/RUN_GOVERNANCE_GUARDS.ps1 -Mode Local -Profile Agent"
  },
  "packageManager": "pnpm@8.15.0+sha512.ea45517d5285d123eac02c3793505fa1fd6da90a2fc60d1e8d9e0c1e9292886ecfaff513f062b9d1cc8021bb8615033b1ac5bea3b2ee3fc165a6d7034bbe6b03",
  "pnpm": {
    "overrides": {
      "expo": "~54.0.0",
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "react-native": "0.81.0"
    }
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "babel-plugin-react-compiler": "19.1.0-rc.2",
    "eslint": "^9.20.1",
    "eslint-config-next": "16.2.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "expo": "~54.0.0",
    "next": "16.2.2",
    "nx": "22.3.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@tamagui/config": "2.0.0-rc.41",
    "tamagui": "2.0.0-rc.41"
  }
}
