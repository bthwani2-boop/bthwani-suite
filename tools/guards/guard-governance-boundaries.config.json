{
  "$schema": "https://bthwani.local/schemas/governance-boundaries-guard.schema.json",
  "version": "1.1.1",
  "evidenceRoot": "tools/registry/runs",
  "failOnError": true,
  "modeDecision": "BOUNDARY_ERRORS_FAIL_LEGACY_WARN_ONLY",
  "extensions": [
    ".ts",
    ".tsx",
    ".js",
    ".jsx",
    ".mjs",
    ".cjs",
    ".md",
    ".json",
    ".jsonc",
    ".yml",
    ".yaml"
  ],
  "scanRoots": [
    "governance",
    "apps",
    "packages/app-shells",
    "packages/surfaces",
    "packages/ui-kit",
    "tools/guards",
    "tools/scripts",
    ".github",
    ".agents",
    ".cursor"
  ],
  "ignore": [
    "(^|/)node_modules(/|$)",
    "(^|/)dist(/|$)",
    "(^|/)build(/|$)",
    "(^|/)coverage(/|$)",
    "(^|/)\\.next(/|$)",
    "(^|/)\\.expo(/|$)",
    "^tools/registry/runs/",
    "\\.map$",
    "\\.lock$"
  ],
  "requiredGovernanceFiles": [
    "governance/00_GOVERNANCE_INDEX.md",
    "governance/01_PLATFORM_SSOT.md",
    "governance/02_BRANCH_AND_EVIDENCE_POLICY.md",
    "governance/03_PACKAGE_BOUNDARY_CONTRACT.md",
    "governance/04_APPS_SHELL_ONLY_CONTRACT.md",
    "governance/05_APP_SHELLS_CONTRACT.md",
    "governance/06_SURFACES_OWNERSHIP_CONTRACT.md",
    "governance/07_UI_KIT_AUTHORITY_CONTRACT.md",
    "governance/08_SCREEN_FILE_MODEL_CONTRACT.md",
    "governance/09_SHARED_FOLDER_GOVERNANCE.md",
    "governance/10_SERVICE_CLOSURE_PROTOCOL.md",
    "governance/11_DSH_GOLDEN_SLICE_PROTOCOL.md",
    "governance/12_API_BINDING_RUNTIME_PROTOCOL.md",
    "governance/13_CI_GATES_CONTRACT.md",
    "governance/14_AGENT_EXECUTION_RULES.md",
    "governance/16_SECURITY_AND_SECRETS_POLICY.md",
    "governance/17_TESTING_AND_PRODUCTION_READINESS.md",
    "governance/18_EVIDENCE_PACK_STANDARD.md",
    "governance/19_PATCH_REVIEW_PROTOCOL.md"
  ],
  "expectedGovernanceFiles": [
    "governance/README.md",
    "governance/15_LEGACY_RETIREMENT_POLICY.md",
    "governance/GUARDS.md"
  ],
  "allowedSurfacesPublicImports": [
    "^@bthwani/surfaces/(app-client|app-partner|app-captain|app-field|control-panel|webapp|website)$"
  ],
  "allowedAppFiles": [
    "^apps/[^/]+/[^/]+/App\\.tsx$",
    "^apps/[^/]+/[^/]+/index\\.(ts|tsx|js|jsx)$",
    "^apps/[^/]+/[^/]+/app\\.config\\.(ts|js)$",
    "^apps/web/[^/]+/(next\\.config|middleware|instrumentation)\\.(ts|js|mjs)$",
    "^apps/web/[^/]+/app/(layout|page)\\.(ts|tsx)$"
  ],
  "allowedBrandColors": [
    "#0a2f5c",
    "#ff500d",
    "#ffffff"
  ],
  "legacyRules": [
    {
      "code": "APP_USER_LEGACY",
      "severity": "warn",
      "pattern": "\\bapp-user\\b",
      "flags": "i",
      "detail": "Legacy app-user token detected. Canonical app is app-client. Warning here; dedicated legacy guard/cleanup handles blocking.",
      "allowPathPatterns": [
        "^governance/",
        "^tools/guards/"
      ],
      "warnPathPatterns": [
        "^\\.github/",
        "^\\.agents/",
        "^\\.cursor/",
        "^governance/legacy-extracted/",
        "^packages/"
      ],
      "allowLinePatterns": [
        "legacy",
        "Legacy",
        "forbidden",
        "Forbidden",
        "canonical",
        "Canonical",
        "Replace",
        "replacement",
        "retirement",
        "Retirement",
        "detected",
        "Detected",
        "token",
        "Token"
      ]
    },
    {
      "code": "MCPW_LEGACY",
      "severity": "warn",
      "pattern": "\\bmcpw\\b",
      "flags": "i",
      "detail": "Legacy mcpw token detected. Canonical surface is control-panel. Warning here; dedicated legacy guard/cleanup handles blocking.",
      "allowPathPatterns": [
        "^governance/",
        "^tools/guards/"
      ],
      "warnPathPatterns": [
        "^\\.github/",
        "^\\.agents/",
        "^\\.cursor/",
        "^governance/legacy-extracted/",
        "^packages/"
      ],
      "allowLinePatterns": [
        "legacy",
        "Legacy",
        "forbidden",
        "Forbidden",
        "canonical",
        "Canonical",
        "Replace",
        "replacement",
        "retirement",
        "Retirement",
        "detected",
        "Detected",
        "token",
        "Token"
      ]
    },
    {
      "code": "OLD_EVIDENCE_ROOT",
      "severity": "warn",
      "pattern": "kdt/volatile/registry/runs|kdt\\\\volatile\\\\registry\\\\runs",
      "flags": "i",
      "detail": "Legacy evidence root detected. Canonical root is tools/registry/runs. Warning here; dedicated legacy guard/cleanup handles blocking.",
      "allowPathPatterns": [
        "^governance/",
        "^tools/guards/"
      ],
      "warnPathPatterns": [
        "^\\.github/",
        "^\\.agents/",
        "^\\.cursor/",
        "^governance/legacy-extracted/",
        "^packages/"
      ],
      "allowLinePatterns": [
        "legacy",
        "Legacy",
        "forbidden",
        "Forbidden",
        "canonical",
        "Canonical",
        "Replace",
        "replacement",
        "retirement",
        "Retirement",
        "detected",
        "Detected",
        "root",
        "Root"
      ]
    },
    {
      "code": "OLD_ACTIVE_BTH_PATH",
      "severity": "warn",
      "pattern": "C:\\\\\\\\bth(?!wani)|C:/bth(?!wani)|(^|[\\\\/])bth([\\\\/]|$)",
      "flags": "i",
      "detail": "Old standalone bth repo/path detected. bthwani/BThwani/@bthwani/bthwani-suite are allowed. Warning here; dedicated legacy guard/cleanup handles blocking.",
      "allowPathPatterns": [
        "^governance/",
        "^tools/guards/"
      ],
      "warnPathPatterns": [
        "^\\.github/",
        "^\\.agents/",
        "^\\.cursor/",
        "^governance/legacy-extracted/",
        "^packages/"
      ],
      "allowLinePatterns": [
        "bthwani",
        "BThwani",
        "@bthwani",
        "bthwani-suite",
        "legacy",
        "Legacy",
        "forbidden",
        "Forbidden",
        "canonical",
        "Canonical",
        "detected",
        "Detected"
      ]
    },
    {
      "code": "NPM_COMMAND_REVIEW",
      "severity": "warn",
      "pattern": "\\bnpm install\\b|\\bnpm run\\b",
      "flags": "i",
      "detail": "npm command detected. pnpm is canonical unless this is documentation of a forbidden pattern.",
      "allowPathPatterns": [
        "^governance/",
        "^tools/guards/"
      ],
      "allowLinePatterns": [
        "pnpm",
        "not npm",
        "no npm",
        "ممنوع",
        "forbidden",
        "Forbidden"
      ]
    }
  ]
}
