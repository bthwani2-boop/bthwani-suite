{
  "$schema": "https://bthwani.local/schemas/unused-dead-orphan-code-guard.schema.json",
  "version": "1.0.0",
  "evidenceRoot": "tools/registry/runs",
  "failOnError": false,
  "extensions": [
    ".ts",
    ".tsx",
    ".js",
    ".jsx",
    ".mjs",
    ".cjs"
  ],
  "scanRoots": [
    "app-client",
    "app-partner",
    "app-captain",
    "app-field",
    "webapp",
    "website",
    "control-panel",
    "ui-kit",
    "dsh",
    "wlt",
    "knz",
    "arb",
    "amn",
    "esf",
    "mrf",
    "snd",
    "kwd",
    "dsh/backend",
    "wlt/backend",
    "knz/backend",
    "arb/backend",
    "amn/backend",
    "esf/backend",
    "mrf/backend",
    "snd/backend",
    "kwd/backend",
    "services"
  ],
  "ignore": [
    "(^|/)node_modules(/|$)",
    "(^|/)dist(/|$)",
    "(^|/)build(/|$)",
    "(^|/)coverage(/|$)",
    "(^|/)\\.next(/|$)",
    "(^|/)\\.expo(/|$)",
    "^tools/registry/runs/",
    "\\.map$",
    "\\.d\\.ts$",
    "\\.test\\.",
    "\\.spec\\."
  ],
  "entryPathPatterns": [
    "^(app-client|app-partner|app-captain|app-field)/App\\.(ts|tsx|js|jsx)$",
    "^(app-client|app-partner|app-captain|app-field)/index\\.(ts|tsx|js|jsx)$",
    "^ui-kit/src/index\\.(ts|tsx|js|jsx)$",
    "^ui-kit/src/web\\.ts$",
    "^ui-kit/src/mobile\\.ts$",
    "^ui-kit/src/next\\.ts$",
    "^ui-kit/src/(web|mobile|components|MobileCommandCenter)/index\\.(ts|tsx|js|jsx)$",
    "^(dsh|wlt|knz|arb|amn|esf|mrf|snd|kwd)/index\\.(ts|tsx|js|jsx)$",
    "^(webapp|website)/app/(layout|page)\\.(ts|tsx)$",
    "^control-panel/runtime/app/(layout|page)\\.(ts|tsx)$",
    "^dsh/backend/src/index\\.(ts|tsx|js|jsx)$",
    "^wlt/backend/src/index\\.(ts|tsx|js|jsx)$",
    "^knz/backend/src/index\\.(ts|tsx|js|jsx)$",
    "^arb/backend/src/index\\.(ts|tsx|js|jsx)$",
    "^amn/backend/src/index\\.(ts|tsx|js|jsx)$",
    "^esf/backend/src/index\\.(ts|tsx|js|jsx)$",
    "^mrf/backend/src/index\\.(ts|tsx|js|jsx)$",
    "^snd/backend/src/index\\.(ts|tsx|js|jsx)$",
    "^kwd/backend/src/index\\.(ts|tsx|js|jsx)$",
  ],
  "protectedPathPatterns": [
    "package\\.json$",
    "project\\.json$",
    "tsconfig\\.json$",
    "next\\.config\\.",
    "metro\\.config\\.",
    "babel\\.config\\.",
    "app\\.config\\.",
    "tamagui\\.config\\.",
    "tamagui\\.build\\."
  ],
  "domainTerms": [
    "dsh",
    "wlt",
    "amn",
    "arb",
    "knz",
    "kwd",
    "mrf",
    "snd",
    "esf",
    "order",
    "orders",
    "store",
    "stores",
    "cart",
    "checkout",
    "captain",
    "merchant",
    "partner",
    "wallet",
    "delivery",
    "shopping"
  ],
  "minDuplicateBytes": 300
}
