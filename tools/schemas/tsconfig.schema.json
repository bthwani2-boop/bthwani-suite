{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./tsconfig.schema.json",
  "title": "Local Tsconfig Schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "extends": {
      "type": "string"
    },
    "compilerOptions": {
      "type": "object",
      "additionalProperties": true
    },
    "include": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}