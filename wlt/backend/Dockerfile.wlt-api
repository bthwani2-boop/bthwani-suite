# BTHWANI_WLT_API Dockerfile
# Multi-stage build: compiles Go binary then runs on alpine.
# Context: wlt/ (workspace root/wlt directory — contains domain/ and backend/).

FROM golang:1.24-alpine AS builder
WORKDIR /src
COPY domain/ ./domain/
COPY backend/go.mod backend/go.sum ./backend/
WORKDIR /src/backend
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/wlt-api ./cmd/wlt-api/

FROM alpine:3.20
RUN apk add --no-cache wget ca-certificates
WORKDIR /app
COPY --from=builder /out/wlt-api ./wlt-api
EXPOSE 8083
ENTRYPOINT ["./wlt-api"]
