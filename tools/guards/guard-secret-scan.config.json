{
  "version": "1.0.0",
  "maxFiles": 2000,
  "ignorePaths": [
    "node_modules/",
    "tools/registry/runs/",
    ".git/",
    ".agents/skills/nodejs-backend-patterns/",
    ".agents/skills/nodejs-backend-patterns/references/",
    "tools/guards/guard-secret-scan.config.json",
    "tools/guards/guard-secret-scan.mjs"
  ],
  "patterns": {
    "PRIVATE_KEY": "-----BEGIN .*PRIVATE KEY-----",
    "AWS_ACCESS_KEY_ID": "\\\\bAKIA[0-9A-Z]{16}\\\\b",
    "GCP_API_KEY": "\\\\bAIza[0-9A-Za-z-_]{35}\\\\b",
    "SLACK_TOKEN": "\\\\bxox[baprs]-[0-9A-Za-z-]{10,}\\\\b"
  }
}
