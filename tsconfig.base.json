{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@bthwani/ui-kit": [
        "packages/ui-kit/src/index.ts"
      ],
      "@bthwani/ui-kit/*": [
        "packages/ui-kit/src/*"
      ],
      "@bthwani/surface-browser": [
        "packages/surface-browser/src/index.ts"
      ],
      "@bthwani/surface-mobile": [
        "packages/surface-mobile/src/index.tsx"
      ],
      "@bthwani/surfaces": [
        "packages/surfaces/src/index.ts"
      ],
      "@bthwani/surfaces/*": [
        "packages/surfaces/src/*"
      ]
    },
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}