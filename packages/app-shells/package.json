{
  "$schema": "../../tools/schemas/package.schema.json",
  "name": "@bthwani/app-shells",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./index.ts",
  "module": "./index.ts",
  "types": "./index.ts",
  "files": [
    "mobile",
    "web",
    "index.ts"
  ],
  "exports": {
    ".": "./index.ts",
    "./mobile": "./mobile/index.ts",
    "./mobile/client": "./mobile/client/index.ts",
    "./mobile/client/mobile-entry": "./mobile/client/mobile-entry.tsx",
    "./mobile/partner": "./mobile/partner/index.ts",
    "./mobile/partner/mobile-entry": "./mobile/partner/mobile-entry.tsx",
    "./mobile/captain": "./mobile/captain/index.ts",
    "./mobile/captain/mobile-entry": "./mobile/captain/mobile-entry.tsx",
    "./mobile/field": "./mobile/field/index.ts",
    "./mobile/field/mobile-entry": "./mobile/field/mobile-entry.tsx",
    "./web": "./web/index.ts",
    "./web/shared": "./web/shared/index.ts",
    "./web/control-panel": "./web/control-panel/index.ts",
    "./web/control-panel/web-entry": "./web/control-panel/web-entry.tsx",
    "./web/webapp": "./web/webapp/index.ts",
    "./web/webapp/web-entry": "./web/webapp/web-entry.tsx",
    "./web/website": "./web/website/index.ts",
    "./web/website/web-entry": "./web/website/web-entry.tsx"
  },
  "dependencies": {
    "@bthwani/surfaces": "workspace:*",
    "@bthwani/ui-kit": "workspace:*"
  }
}