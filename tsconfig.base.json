{
  "$schema": "./tools/schemas/tsconfig.schema.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "paths": {
      "@bthwani/api-clients": [
        "./packages/api-clients/src/index.ts"
      ],
      "@bthwani/api-types": [
        "./packages/api-types/src/index.ts"
      ],
      "@bthwani/ui-kit": [
        "./packages/ui-kit/src/index.ts"
      ],
      "@bthwani/surface-mobile": [
        "./packages/surface-mobile/src/index.tsx"
      ],
      "@bthwani/surfaces": [
        "./packages/surfaces/src/index.ts"
      ],
      "@bthwani/surfaces/*": [
        "./packages/surfaces/src/*"
      ]
    },
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
