{
  "name": "app-client",
  "root": "app-client",
  "sourceRoot": "app-client",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir app-client/runtime exec expo start --dev-client --clear"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir app-client/runtime exec expo export --platform android"
      }
    },
    "serve-go": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir app-client/runtime exec expo start --go --clear"
      }
    },
    "android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir app-client/runtime exec expo run:android --no-bundler"
      }
    },
    "config": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir app-client/runtime exec expo config --json"
      }
    }
  }
}
