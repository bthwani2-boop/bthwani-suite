{
  "guard": "GUARD-23_SCRIPT_SAFETY",
  "version": "1.0.0",
  "mode": "CHECK_ONLY",
  "policy": {
    "defaultSeverity": "warning"
  },
  "dangerPatterns": [
    "rm -rf",
    "Remove-Item",
    "git reset --hard",
    "git push --force",
    "force push",
    "del /s",
    "rmdir /s",
    "Invoke-Expression",
    "iex "
  ]
}