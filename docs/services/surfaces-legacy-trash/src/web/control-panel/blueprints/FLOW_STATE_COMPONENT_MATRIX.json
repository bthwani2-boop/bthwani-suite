{
  "version": "2026-03-28",
  "designName": "AI-Native Premium Command Center",
  "flows": [
    {
      "id": "F01",
      "name": "critical_action_fast_path",
      "entry": "overview.primary_cta",
      "steps": ["click_primary_cta", "open_target_page"],
      "maxClicks": 1,
      "ownedBy": ["home", "finance", "support"],
      "stateCoverage": ["loading", "success", "error", "empty"]
    },
    {
      "id": "F02",
      "name": "kpi_drilldown",
      "entry": "overview.focus_strip.card",
      "steps": ["click_kpi_card", "open_filtered_destination"],
      "maxClicks": 1,
      "ownedBy": ["home", "analytics", "operations"],
      "stateCoverage": ["loading", "success"]
    },
    {
      "id": "F03",
      "name": "workspace_launch",
      "entry": "overview.workspace_launch_card",
      "steps": ["click_workspace_card", "open_workspace"],
      "maxClicks": 1,
      "ownedBy": ["home", "sidebar"],
      "stateCoverage": ["success", "permission_denied"]
    },
    {
      "id": "F04",
      "name": "service_scope_switch",
      "entry": "topbar.service_scope_selector",
      "steps": ["open_selector", "select_scope", "route_restore"],
      "maxClicks": 2,
      "ownedBy": ["topbar", "shell"],
      "stateCoverage": ["success", "unsaved_guard"]
    },
    {
      "id": "F05",
      "name": "error_recovery",
      "entry": "overview.error_banner",
      "steps": ["dismiss_or_retry", "refresh_data"],
      "maxClicks": 2,
      "ownedBy": ["home"],
      "stateCoverage": ["error", "loading", "success"]
    },
    {
      "id": "F06",
      "name": "sidebar_progressive_disclosure",
      "entry": "sidebar.section_toggle",
      "steps": ["toggle_section", "open_child_route"],
      "maxClicks": 2,
      "ownedBy": ["sidebar"],
      "stateCoverage": ["collapsed", "expanded", "active"]
    },
    {
      "id": "F07",
      "name": "command_palette_navigation",
      "entry": "header.command_button_or_ctrl_k",
      "steps": ["open_palette", "choose_item", "navigate"],
      "maxClicks": 2,
      "ownedBy": ["home", "command_palette"],
      "stateCoverage": ["open", "filtered", "selected", "closed"]
    },
    {
      "id": "F08",
      "name": "keyboard_assisted_sidebar",
      "entry": "alt_number_shortcut",
      "steps": ["press_alt_number", "route_navigation"],
      "maxClicks": 1,
      "ownedBy": ["sidebar"],
      "stateCoverage": ["success", "focus_search"]
    }
  ],
  "stateMatrix": [
    {
      "screen": "overview",
      "state": "loading",
      "trigger": "initial_fetch_or_refresh",
      "render": "skeleton_cards_and_rows",
      "recovery": "auto_to_success"
    },
    {
      "screen": "overview",
      "state": "success",
      "trigger": "data_available_or_fallback",
      "render": "focus_strip_action_center_workspace_grid",
      "recovery": "none"
    },
    {
      "screen": "overview",
      "state": "error",
      "trigger": "work_queue_error",
      "render": "dismissible_warning_banner",
      "recovery": "refresh_or_dismiss"
    },
    {
      "screen": "overview",
      "state": "empty",
      "trigger": "queue_empty",
      "render": "fallback_actions_or_empty_message",
      "recovery": "workspace_launch"
    },
    {
      "screen": "shell",
      "state": "unauthenticated",
      "trigger": "auth_false",
      "render": "auth_required_guard",
      "recovery": "login"
    },
    {
      "screen": "shell",
      "state": "unsaved_guard",
      "trigger": "service_switch_with_unsaved_changes",
      "render": "confirm_dialog",
      "recovery": "cancel_or_continue"
    }
  ],
  "componentMatrix": [
    {
      "id": "C01",
      "name": "TopNavigationBar",
      "scope": "ui-kit",
      "reusable": true,
      "contracts": [
        "search_entry",
        "service_scope_picker",
        "notifications",
        "user_menu"
      ]
    },
    {
      "id": "C02",
      "name": "SideNavigation",
      "scope": "ui-kit",
      "reusable": true,
      "contracts": [
        "single_expand_section",
        "search_shortcut",
        "quick_nav_shortcut"
      ]
    },
    {
      "id": "C03",
      "name": "FocusKpiCard",
      "scope": "control panel/home",
      "reusable": true,
      "contracts": ["value", "delta", "direct_link"]
    },
    {
      "id": "C04",
      "name": "QueueActionRow",
      "scope": "control panel/home",
      "reusable": true,
      "contracts": ["priority", "owner", "due", "single_action"]
    },
    {
      "id": "C05",
      "name": "WorkspaceLaunchCard",
      "scope": "control panel/home",
      "reusable": true,
      "contracts": ["title", "subtitle", "entry_action"]
    },
    {
      "id": "C06",
      "name": "CommandPalette",
      "scope": "control panel/components",
      "reusable": true,
      "contracts": ["open_close", "search", "navigate"]
    }
  ]
}

