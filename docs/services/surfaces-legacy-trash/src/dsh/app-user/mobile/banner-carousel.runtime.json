{
  "bannerCarousel": {
    "enabled": true,
    "variant": "cinematic_depth_hero",
    "layout": {
      "widthMode": "full_screen",
      "height": 172,
      "radius": 24,
      "cardWidthOffset": 44,
      "itemGap": 14,
      "overflowVisible": true,
      "showAdjacentPeek": true
    },
    "autoplay": {
      "enabled": true,
      "intervalMs": 3400,
      "resumeAfterMs": 1100,
      "pauseOnTouch": true,
      "pauseOnDrag": true,
      "loop": true
    },
    "interaction": {
      "rtl": true,
      "snapEnabled": true,
      "snapThreshold": 0.22,
      "hapticsEnabled": true,
      "tapOpensBanner": true,
      "manualDragOverridesAutoplay": true
    },
    "motion": {
      "type": "cinematic_depth",
      "centerScale": 1.0,
      "sideScale": 0.92,
      "farScale": 0.88,
      "sideOpacity": 0.76,
      "farOpacity": 0.58,
      "rotateYSideDeg": 8,
      "translateXSideFactor": 0.92,
      "glowOpacity": 0.14,
      "shadowOpacity": 0.22,
      "shadowRadius": 18,
      "parallaxImageShift": 12
    },
    "progress": {
      "enabled": true,
      "type": "bar",
      "position": "bottom_inside",
      "height": 3,
      "useActiveBannerAccent": true
    },
    "readability": {
      "vignetteEnabled": true,
      "vignetteOpacity": 0.08,
      "titleOverlayEnabled": false
    },
    "performance": {
      "expoGoFriendly": true,
      "useNativeDriver": true,
      "avoidHeavyBlur": true,
      "avoidRealtimeShaders": true
    }
  }
}
