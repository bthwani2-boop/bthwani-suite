{
  "version": "1.0.0",
  "mode": "advisory-first",
  "scanRoots": [
    "app-client/runtime",
    "app-partner/runtime",
    "app-captain/runtime",
    "app-field/runtime",
    "control-panel/runtime",
    "webapp/runtime",
    "website/runtime",
    "ui-kit",
    "dsh",
    "wlt",
    "knz",
    "arb",
    "amn",
    "esf",
    "mrf",
    "snd",
    "kwd",
    "tools"
  ],
  "scatterBuckets": [
    "shared",
    "common",
    "utils",
    "helpers",
    "lib",
    "core",
    "base",
    "misc"
  ],
  "oldTempNamingPatterns": [
    "_old",
    "_OLD",
    "-old",
    "-OLD",
    ".old",
    "_copy",
    "_COPY",
    "-copy",
    "-COPY",
    "_bak",
    "_BAK",
    "-bak",
    "_temp",
    "_TEMP",
    "-temp",
    "_tmp",
    "-tmp",
    "_v1",
    "_v2",
    "_v3",
    "_draft",
    "_DRAFT",
    "-draft",
    "_wip",
    "_WIP",
    "-wip",
    "BACKUP",
    "backup",
    "deprecated",
    "Deprecated",
    "_new",
    "_NEW",
    "-new"
  ],
  "largeFileSizeBytes": 30000,
  "tinyFileSizeBytes": 80,
  "skipDirs": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    ".next",
    ".expo",
    ".turbo",
    ".nx",
    ".git",
    "android",
    "ios",
    "tools/registry/runs"
  ],
  "skipRelativePatterns": [
    ".test.",
    ".spec.",
    ".stories.",
    ".story.",
    "__tests__",
    "__generated__",
    "fixture",
    "fixtures",
    "mock",
    "mocks"
  ],
  "allowedScatterRoots": [
    "tools/guards/lib",
    "ui-kit/src/utils",
    "ui-kit/src/lib"
  ]
}
